{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=118.139.165.158;Initial Catalog=WhatsAppLogs;Integrated Security=false;user id=dbuser;password=D$B2@24B@bji;TrustServerCertificate=True",
          "sinkOptionsSection": {
            "tableName": "WhatsAppBridgeLogs",
            "schemaName": "dbo",
            "autoCreateSqlTable": true,
            "batchPostingLimit": 25,
            "period": "0.00:01:00"
          },
          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "ServerIp",
                "PropertyName": "ServerIp",
                "DataType": "varchar",
                "DataLength": 50,
                "AllowNull": true
              },
              {
                "ColumnName": "ClientId",
                "PropertyName": "ClientId",
                "DataType": "bigint",
                "AllowNull": true
              }
            ]
          },
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  }
}
